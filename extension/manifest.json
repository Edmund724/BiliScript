{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "2.3.0",
  "default_locale": "zh_CN",
  "minimum_chrome_version": "120",
  "description": "__MSG_appDesc__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "offscreen",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://api.tavily.com/*",
    "https://api.exa.ai/*",
    "https://api.search.brave.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "entry/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/list/watchlater",
        "https://www.bilibili.com/list/watchlater/",
        "https://www.bilibili.com/list/watchlater/*"
      ],
      "js": ["entry/content-bootstrap.iife.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "entry/content-main.mjs",
        "entry/chunks/*",
        "entry/styles/*"
      ],
      "matches": ["https://www.bilibili.com/*"]
    }
  ],
  "action": {
    "default_title": "BiliScript｜B站视频文摘",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
