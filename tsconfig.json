{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force"
  },
  "include": [
    "extension/**/*.js",
    "extension/**/*.ts",
    "extension/**/*.d.ts",
    "tests/setup.ts",
    "tests/layer-deps.test.ts",
    "tests/helpers/**/*.ts",
    "tests/notes/**/*.ts",
    "tests/shared/**/*.ts",
    "tests/search/**/*.ts",
    "tests/bilibili/**/*.ts",
    "tests/entry/**/*.ts",
    "tests/reader/**/*.ts",
    "tests/core/**/*.ts",
    "tests/asr/**/*.ts",
    "tests/subtitle/**/*.ts",
    "tests/chat/**/*.ts",
    "tests/ui/**/*.ts",
    "tests/ai/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
