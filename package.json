{
  "name": "biliscript",
  "version": "2.3.0",
  "description": "B 站视频字幕阅读与 AI 总结浏览器扩展",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "build:content": "node scripts/build-content.js",
    "build:release": "python3 scripts/build_release.py",
    "catalog:sync": "node scripts/sync-pi-ai-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval:run": "node_modules/.bin/esbuild eval/run.ts --bundle --platform=node --format=esm --outfile=eval/run.mjs && node eval/run.mjs",
    "eval:sweep": "node_modules/.bin/esbuild eval/sweep.ts --bundle --platform=node --format=esm --outfile=eval/sweep.mjs && node eval/sweep.mjs",
    "smoke:mermaid": "node scripts/mermaid-smoke/serve.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Edmund724/BiliScript.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Edmund724/BiliScript/issues"
  },
  "homepage": "https://github.com/Edmund724/BiliScript#readme",
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@vitest/coverage-v8": "^4.1.11",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "esbuild": "^0.28.2",
    "github-markdown-css": "^5.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "mermaid": "^11.17.2"
  }
}
